{
  "permissions": {
    "deny": [
      "Edit(//home/alex/keys)",
      "Edit(//home/alex/keys/**)",
      "Read(//home/alex/keys)",
      "Read(//home/alex/keys/**)"
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash /home/alex/nixos-config/dotfiles/.config/claude/statusline-command.sh"
  },
  "autoMemoryDirectory": "/home/alex/.claude/projects/-home-alex-nixos-config/memory",
  "theme": "dark",
  "inputNeededNotifEnabled": false,
  "agentPushNotifEnabled": false,
  "modelSettings": {
