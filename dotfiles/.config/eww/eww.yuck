(defwidget bar []
    (centerbox :orientation "h"
    (workspaces)
    (box)
    (label :halign "end" :text time)
    )
)


(defwidget workspaces []
  (box :class "workspaces"
       :orientation "h"
       :halign "start"
       :space-evenly true
       :spacing 10
    (button :onclick "hyprctl dispatch \"hl.dsp.focus({ workspace = '1' })\"" 1)
    (button :onclick "hyprctl dispatch \"hl.dsp.focus({ workspace = '2' })\"" 2)
    (button :onclick "hyprctl dispatch \"hl.dsp.focus({ workspace = '3' })\"" 3)
    (button :onclick "hyprctl dispatch \"hl.dsp.focus({ workspace = '4' })\"" 4)
    (button :onclick "hyprctl dispatch \"hl.dsp.focus({ workspace = '5' })\"" 5)
    (button :onclick "hyprctl dispatch \"hl.dsp.focus({ workspace = '6' })\"" 6)
    (button :onclick "hyprctl dispatch \"hl.dsp.focus({ workspace = '7' })\"" 7)
    (button :onclick "hyprctl dispatch \"hl.dsp.focus({ workspace = '8' })\"" 8)
    (button :onclick "hyprctl dispatch \"hl.dsp.focus({ workspace = '9' })\"" 9)))


(defpoll time :interval "1s"
  "date '+%H:%M %b %d, %Y'")

(defwindow bar
  :monitor 0
  :exclusive true
  :geometry (geometry :x "0%"
                      :y "0%"
                      :width "100%"
                      :height "5px"
                      :anchor "top center")
  (bar))

