(defwidget bar []
  (centerbox :class "bar"
             :orientation "h"
    (workspaces)
    (box)
    (box :halign "end"
         :spacing 15
      (brightness)
      (label :text time))))


(defwidget brightness []
  ; max is exclusive in eww, so 101 to reach 100%. timeout throttles the slow DDC/CI writes while dragging
  (scale :class "brightness"
         :min 0
         :max 101
         :round-digits 0
         :timeout "300ms"
         :value brightness
         :onchange "brightnessctl -c backlight set {}%"))


; The monitor can also be changed with its own buttons, so poll for the current value
(defpoll brightness :interval "5s" :initial "0"
  "info=$(brightnessctl -c backlight -m info) && echo \"$info\" | cut -d, -f4 | tr -d % || echo 0")


(defwidget workspaces []
  (box :class "workspaces"
       :orientation "h"
       :halign "start"
       :space-evenly true
       :spacing 10
    (for ws in "[1, 2, 3, 4, 5, 6, 7, 8, 9]"
      (button :class {active_ws == ws ? "active" : ""}
              :onclick "hyprctl dispatch \"hl.dsp.focus({ workspace = '${ws}' })\""
        (label :text ws)))))


(deflisten active_ws :initial "1"
  "bash ~/.config/eww/scripts/active-workspace.sh")

; Only minutes are shown, so polling every second is wasted work
(defpoll time :interval "10s"
  "date '+%H:%M %b %d, %Y'")

(defwindow bar
  :monitor 0
  :exclusive true
  :geometry (geometry :x "0%"
                      :y "0%"
                      :width "100%"
                      :height "5px"
                      :anchor "top center")
  (bar))
