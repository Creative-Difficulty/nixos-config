(defwidget bar []
  (centerbox :class "bar"
             :orientation "h"
    (workspaces)
    (box)
    (label :halign "end" :text time)))


(defwidget workspaces []
  (box :class "workspaces"
       :orientation "h"
       :halign "start"
       :space-evenly true
       :spacing 10
    (for ws in "[1, 2, 3, 4, 5, 6, 7, 8, 9]"
      (button :onclick "hyprctl dispatch \"hl.dsp.focus({ workspace = '${ws}' })\""
        (label :text ws)))))


; Only minutes are shown, so polling every second is wasted work
(defpoll time :interval "10s"
  "date '+%H:%M %b %d, %Y'")

(defwindow bar
  :monitor 0
  :exclusive true
  :geometry (geometry :x "0%"
                      :y "0%"
                      :width "100%"
                      :height "5px"
                      :anchor "top center")
  (bar))
